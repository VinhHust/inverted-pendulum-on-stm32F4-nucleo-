#include "velotofreq.h"
stepper_command_t Func_VeltoFreq(float vtarget){
	stepper_command_t cmd;
if (vtarget >= 0.0f){
	cmd.direction = DIR_CW_RIGHT;
}
else {
        cmd.direction = DIR_CCW_LEFT;
    }
return cmd;
}
