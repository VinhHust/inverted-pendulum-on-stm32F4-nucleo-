void init_pendulum(InvertedPendulumTypeDef* pendulum) {
	pendulum->state = IDLE_PENDULUM;
	//con trỏ lồng con trỏ, con trỏ pendulum truy cập tới con trỏ steppẻ
	Stepper_UpdateCartFrequency(pendulum->stepper, 0);
}
