#include "inverted_pendulum.h"

#define POSTIVE_VEL_STARTUP   1.5f
#define SPEED_WAIT_TIME       50
#define ANGLE_ZERO_PLUS       0.157
#define ANGLE_ZERO_NEG        -0.157
#define ANGLE_LIMIT_POS       3
#define ANGLE_LIMIT_NEG       -3

#define FREQUENCY             200

static float lqr_val[4] = {140.84, -14.22, 2.00, 2.00};
void init_pendulum(InvertedPendulumTypeDef* pendulum)
{
	pendulum->state = IDLE_PENDULUM;
	pendulum->wait_time_counter = 0;
	reset_encoder(pendulum->encoder);
	l6474_init(pendulum->motor);
	l6474_enable(pendulum->motor);
}

void start_pendulum(InvertedPendulumTypeDef* pendulum)
{
	pendulum->state = START_PENDULUM;
}

volatile float speed_command = 0;
void run_pendulum(InvertedPendulumTypeDef* pendulum)
{
	static float speed_start = POSTIVE_VEL_STARTUP;
	static float reference_point;
	l6474_get_speed_pos(pendulum->motor);
	update_encoder(pendulum->encoder);

	if(pendulum->encoder->angle_pos > -0.314 &&
			pendulum->encoder->angle_pos < 0.314 && pendulum->state == SWITCH_CONTROL)
	{
		l6474_set_vel(pendulum->motor, 0, 0);
		pendulum->state = IDLE_PENDULUM;
	}
	switch(pendulum->state)
	{
	case IDLE_PENDULUM:
		pendulum->state = IDLE_PENDULUM;
		break;

	case START_PENDULUM:
		pendulum->wait_time_counter++;
		pendulum->state = START_PENDULUM;
		l6474_set_vel(pendulum->motor, 0, speed_start);
		if(pendulum->wait_time_counter == SPEED_WAIT_TIME)
		{
			pendulum->wait_time_counter = 0;
			pendulum->state = WAIT_ZERO_ANGLE;
		}
		break;
	case WAIT_ZERO_ANGLE:
		if(pendulum->encoder->angle_pos < -0.078 &&
				pendulum->encoder->angle_pos > -0.157)
		{
				pendulum->state = WAIT_ZERO_ANGLE;
				l6474_set_vel(pendulum->motor, 0, -speed_start);
		}
	   else if(pendulum->encoder->angle_pos > 0.078 &&
			   pendulum->encoder->angle_pos < 0.157)
		{
			pendulum->state = WAIT_ZERO_ANGLE;
			l6474_set_vel(pendulum->motor, 0, speed_start);
		}
	   else if((pendulum->encoder->angle_pos > TWOPI/2 - TWOPI/15 ||
			   pendulum->encoder->angle_pos < -TWOPI/2 + TWOPI/15))
	   {
		   l6474_set_vel(pendulum->motor, 0, 0);
		   reference_point = pendulum->motor->motors->speed_pos.rad_pos;
		   pendulum->state = SWITCH_CONTROL;
	   }
	   else
	   {

	   }
		break;
	case SWITCH_CONTROL:
		float lqr_out;
		if(pendulum->encoder->angle_pos > 0)
		{ //Tính độ chênh lệch giữa thực tế và lí tưởng
			lqr_out = lqr_val[0] * ( TWOPI/2 - pendulum->encoder->angle_pos);
		}
		else
		{
			lqr_out = lqr_val[0] * (-pendulum->encoder->angle_pos - TWOPI/2);
		}
// nhân với frequency đồng nghĩa chia với dt, angle_speed chỉ là sai lệch góc rồi chia cho thời gian thì ra vận tốc góc
		lqr_out +=	lqr_val[1] * pendulum->encoder->angle_speed * FREQUENCY;
		lqr_out -=	lqr_val[2] * (pendulum->motor->motors->speed_pos.rad_pos - reference_point) +
					lqr_val[3] * pendulum->motor->motors->speed_pos.rad_speed * FREQUENCY;


		speed_command -= lqr_out / FREQUENCY; //speed command là tích phân ngược lại ra gia tốc
		l6474_set_vel(pendulum->motor, 0, speed_command);
		break;
	}
}
